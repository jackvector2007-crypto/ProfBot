def generer_question_totale():
global quiz_actif, pool_questions_restantes, mode_interro

if mode_interro and pool_questions_restantes:
sujet_cle, type_q = pool_questions_restantes.pop()
else:
type_q = random.choice(
["elem_num", "savant_contrib", "quantique_formule", "thermo_formule"]
)
if type_q == "elem_num":
sujet_cle = random.choice(list(TABLEAU.keys()))
elif type_q == "savant_contrib":
sujet_cle = random.choice(list(SAVANTS.keys()))
elif type_q == "quantique_formule":
sujet_cle = random.choice(list(QUANTIQUE.keys()))
else:
sujet_cle = random.choice(list(THERMODYNAMIQUE.keys()))

if type_q == "elem_num":
elem = TABLEAU[sujet_cle]
question = f"❓ [Chimie] Quel est le numéro atomique (Z) de l'élément {elem['nom']} ?"
reponse_correcte = str(elem["num"])
faux1 = str(max(1, elem["num"] + 3))
faux2 = str(max(1, elem["num"] - 2))
faux3 = str(elem["num"] + 5)
options = [reponse_correcte, faux1, faux2, faux3]
random.shuffle(options)
explication = f"L'élément {elem['nom']} possède le numéro atomique {elem['num']}."

elif type_q == "savant_contrib":
s = SAVANTS[sujet_cle]
question = f"❓ [Histoire] À quel savant attribue-t-on cette contribution :\n*"{s['contribution']}"*"
reponse_correcte = s["nom"]
tous_noms = [sav["nom"] for sav in SAVANTS.values()]
mauvais = random.sample(
[n for n in tous_noms if n.lower() != reponse_correcte.lower()], 3
)
options = mauvais + [reponse_correcte]
random.shuffle(options)
explication = f"Il s'agit de {s['nom']} ({s['siecle']})."

elif type_q == "quantique_formule":
item = QUANTIQUE[sujet_cle]
question = (
f"❓ [Quantique] Quelle est l'expression associée à :\n*{item['nom']}* ?"
)
reponse_correcte = item["formule"]
tous_val = [v["formule"] for v in QUANTIQUE.values()]
mauvais = [v for v in tous_val if v != reponse_correcte][:3]
options = mauvais + [reponse_correcte]
random.shuffle(options)
explication = f"La relation exacte est {item['formule']}."

else:
item = THERMODYNAMIQUE[sujet_cle]
question = (
f"❓ [Thermodynamique] Quelle est la relation associée à"
f" :\n*{item['nom']}* ?"
)
reponse_correcte = item["formule"]
tous_val = [v["formule"] for v in THERMODYNAMIQUE.values()]
mauvais = [v for v in tous_val if v != reponse_correcte][:3]
options = mauvais + [reponse_correcte]
random.shuffle(options)
explication = f"La relation associée est {item['formule']}."

lettres = ["a", "b", "c", "d"]
options_texte = ""
bonne_lettre = ""

for i, opt in enumerate(options[:4]):
lettre = lettres[i]
options_texte += f"\n {lettre.upper()}) {opt}"
if str(opt).lower() == str(reponse_correcte).lower():
bonne_lettre = lettre

quiz_actif = {
"reponse": str(reponse_correcte).lower(),
"bonne_lettre": bonne_lettre,
"explication": explication,
"acceptables": [str(reponse_correcte).lower()],
}

return f"{question}\n{options_texte}\n\n👉 Tape la lettre (A, B, C, D) :"


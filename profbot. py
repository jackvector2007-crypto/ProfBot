def repondre(msg):
global quiz_actif, mode_interro, pool_questions_restantes, objectif_interro, user_stats
msg = msg.lower().strip()

if quiz_actif:
try:
user_stats["total_questions"] += 1
reponse_correcte = False
if msg == quiz_actif["reponse"] or msg in quiz_actif.get(
"acceptables", []
):
reponse_correcte = True
elif "bonne_lettre" in quiz_actif and msg == quiz_actif["bonne_lettre"]:
reponse_correcte = True

  if reponse_correcte:
    user_stats["score_actuel"] += 1
    rep = f"✅ **Correct !** {quiz_actif['explication']}"
  else:
    rep = (
        f"❌ **Faux !** C'était : **{quiz_actif['reponse']}**\n"
        f"{quiz_actif['explication']}"
    )
  quiz_actif = None

  if mode_interro and user_stats["total_questions"] < objectif_interro:
    return rep + "\n\n" + generer_question_totale()
  elif mode_interro:
    note = (user_stats["score_actuel"] * 20) // objectif_interro
    if user_stats["score_actuel"] > user_stats["meilleur_score"]:
      user_stats["meilleur_score"] = user_stats["score_actuel"]

    user_stats["parties_jouees"] += 1
    verifier_badges()
    sauvegarder()

    mode_interro = False
    rep_final = (
        f"{rep}\n\n🏁 **BILAN DE L'INTERROGATION ABSOLUE**\nScore :"
        f" {user_stats['score_actuel']}/{user_stats['total_questions']}\nNote"
        f" équivalente : {note}/20\n🏆 Record Personnel :"
        f" {user_stats['meilleur_score']}"
    )
    user_stats["score_actuel"] = 0
    user_stats["total_questions"] = 0
    pool_questions_restantes = []
    return rep_final
  return rep
except:
